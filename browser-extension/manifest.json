{
  "manifest_version": 3,
  "name": "Jarvis Browser Companion",
  "version": "1.0.0",
  "description": "Control your browser using Jarvis AI Assistant",
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel",
    "storage",
    "history"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self';"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://sou842.github.io/*",
        "https://sourav-samnta-fabg.vercel.app/*",
        "https://assistant-nine-ecru.vercel.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Jarvis Browser Companion",
    "default_icon": "icon.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "sidebar_action": {
    "default_title": "Jarvis Browser Companion",
    "default_panel": "sidepanel.html",
    "default_icon": "icon.png"
  }
}