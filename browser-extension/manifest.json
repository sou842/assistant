{
  "manifest_version": 3,
  "name": "Jarvis Browser Companion",
  "version": "1.0.0",
  "description": "Control your browser using Jarvis AI Assistant",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://sou842.github.io/*",
        "https://sourav-samnta-fabg.vercel.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Jarvis Browser Companion",
    "default_icon": "icon.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "sidebar_action": {
    "default_title": "Jarvis Browser Companion",
    "default_panel": "sidepanel.html",
    "default_icon": "icon.png"
  }
}
